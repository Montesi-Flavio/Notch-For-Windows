<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colors -->
    <SolidColorBrush x:Key="NotchBackgroundBrush" Color="#FF000000"/>
    <SolidColorBrush x:Key="NotchAccentBrush"     Color="#FF2A2A2A"/>
    <SolidColorBrush x:Key="NotchSeparatorBrush"  Color="#FF2C2C2C"/>

    <!-- Text: primary 100%, secondary 55% -->
    <Style x:Key="ModuleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground"   Value="White"/>
        <Setter Property="FontFamily"   Value="Segoe UI Variable Display, Segoe UI, sans-serif"/>
        <Setter Property="FontSize"     Value="12"/>
        <Setter Property="LineHeight"   Value="16"/>
    </Style>

    <Style x:Key="ModuleSecondaryTextStyle" TargetType="TextBlock"
           BasedOn="{StaticResource ModuleTextStyle}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Opacity"  Value="0.55"/>
    </Style>

    <!-- Thin vertical divider between modules -->
    <Style x:Key="ModuleDividerStyle" TargetType="Rectangle">
        <Setter Property="Width"   Value="1"/>
        <Setter Property="Height"  Value="18"/>
        <Setter Property="Fill"    Value="{StaticResource NotchSeparatorBrush}"/>
        <Setter Property="Margin"  Value="8,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

</ResourceDictionary>
