<Window x:Class="Notch.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Impostazioni Notch"
        Width="520"
        Height="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FF121212"
        Foreground="White"
        WindowStyle="SingleBorderWindow">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Impostazioni app" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>

            <GroupBox Grid.Row="1" Header="Notch" Margin="0,0,0,12" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Larghezza base"/>
                        <TextBox x:Name="BaseWidthBox" Margin="0,6,0,0" Padding="8"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Larghezza espansa"/>
                        <TextBox x:Name="ExpandedWidthBox" Margin="0,6,0,0" Padding="8"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,12,12,0">
                        <TextBlock Text="Altezza base"/>
                        <TextBox x:Name="BaseHeightBox" Margin="0,6,0,0" Padding="8"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,12,0,0">
                        <TextBlock Text="Altezza espansa"/>
                        <TextBox x:Name="ExpandedHeightBox" Margin="0,6,0,0" Padding="8"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="2" Header="Spotify" Margin="0,0,0,12" Padding="12">
                <StackPanel>
                    <TextBlock Text="Redirect URI"/>
                    <TextBox x:Name="SpotifyRedirectBox" Margin="0,6,0,0" Padding="8"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="3" Header="Funzionalità" Margin="0,0,0,12" Padding="12">
                <StackPanel>
                    <CheckBox x:Name="EnableMusicCheck" Content="Abilita modulo musica" Margin="0,0,0,8"/>
                    <CheckBox x:Name="EnableBatteryCheck" Content="Abilita modulo batteria" Margin="0,0,0,8"/>
                    <CheckBox x:Name="EnableCameraCheck" Content="Abilita modalità videocamera/specchio" Margin="0,0,0,8"/>
                    <CheckBox x:Name="EnableNotesCheck" Content="Abilita integrazione note Microsoft"/>
                </StackPanel>
            </GroupBox>

            <TextBlock Grid.Row="4"
                       Text="Apri il pannello con Ctrl+,"
                       Opacity="0.7"
                       Margin="0,0,0,16"/>

            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annulla" Width="100" Margin="0,0,10,0" Padding="8" Click="Cancel_Click"/>
                <Button Content="Salva" Width="100" Padding="8" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>