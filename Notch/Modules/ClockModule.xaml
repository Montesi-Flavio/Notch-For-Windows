<local:NotchModuleBase x:Class="Notch.Modules.ClockModule"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:local="clr-namespace:Notch.Core">

    <StackPanel x:Name="RootPanel"
                Orientation="Vertical"
                VerticalAlignment="Center"
                Margin="12,6">
        <TextBlock x:Name="TxtTime"
                   Text="--:--:--"
                   FontSize="18"
                   FontFamily="DS-Digital, Digital-7, Cascadia Mono, Consolas"
                   FontWeight="SemiBold"
                   Foreground="White"/>
        <TextBlock x:Name="TxtDate"
                   Text="--- --/--/----"
                   Style="{StaticResource ModuleSecondaryTextStyle}"
                   FontSize="11"
                   Margin="0,2,0,0"/>
    </StackPanel>
</local:NotchModuleBase>
