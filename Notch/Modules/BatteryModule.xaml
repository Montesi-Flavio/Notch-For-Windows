<local:NotchModuleBase x:Class="Notch.Modules.BatteryModule"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:local="clr-namespace:Notch.Core">

    <StackPanel Orientation="Horizontal"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Margin="12,0">

        <!-- Icona batteria -->
        <Grid VerticalAlignment="Center">
            <!-- Corpo batteria -->
            <Border Width="26" Height="13"
                    BorderThickness="1.5"
                    BorderBrush="White"
                    CornerRadius="3"
                    Margin="0,0,3,0">
                <Grid Margin="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="FillCol"  Width="*"/>
                        <ColumnDefinition x:Name="EmptyCol" Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="BatteryFill"
                            Grid.Column="0"
                            Background="White"
                            CornerRadius="1.5,0,0,1.5"/>
                </Grid>
            </Border>
            <!-- Terminale positivo -->
            <Border Width="3" Height="7"
                    Background="White"
                    CornerRadius="0,1.5,1.5,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,-1.5,0"/>
            <!-- Bolt carica (visibile solo quando in carica) -->
            <TextBlock x:Name="TxtBolt"
                       Text="⚡"
                       FontSize="8"
                       Foreground="#FF000000"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="0,0,3,0"
                       Visibility="Collapsed"/>
        </Grid>

        <!-- Percentuale -->
        <TextBlock x:Name="TxtPercent"
                   Text="—%"
                   Style="{StaticResource ModuleTextStyle}"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   Margin="4,0,0,0"/>
    </StackPanel>
</local:NotchModuleBase>
